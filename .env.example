# ========== Application ==========
APP_NAME=Pronunciation Validator
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
PORT=8000
DEBUG=true

# ========== Model Config ==========
ASR_MODEL_NAME=facebook/wav2vec2-large-960h-lv60-self
ASR_MODEL_CACHE_DIR=./model_cache
DEVICE=cpu

# ========== Audio Config ==========
AUDIO_SAMPLE_RATE=16000
AUDIO_MAX_DURATION_SEC=30

# ========== Security ==========
# API key required in X-API-Key header for all protected endpoints.
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secret-api-key-here

# ========== CORS ==========
# Comma-separated list of allowed origins (no spaces around commas).
# Use * to allow all origins (development only).
# Example: CORS_ORIGINS_STR=https://app.example.com,https://admin.example.com
CORS_ORIGINS_STR=*

# ========== Concurrency ==========
# Max ML inference jobs running at the same time. Extra requests are queued.
MAX_CONCURRENT_INFERENCES=2

# ========== Logging ==========
LOG_LEVEL=INFO
