# ========== Application ==========
APP_NAME=Pronunciation Validator
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
PORT=8000
# DEBUG=true skips API key strength validation. Always set DEBUG=false in prod.
DEBUG=true

# ========== Model Config ==========
ASR_MODEL_NAME=facebook/wav2vec2-large-960h-lv60-self
ASR_MODEL_CACHE_DIR=./model_cache
DEVICE=cpu

# ========== ASR Backend (Phase 03) ==========
# torch_fp32 (default, safe) | torch_int8 (1.4-2x faster, requires sanity gate)
INFERENCE_BACKEND=torch_fp32

# ========== Audio Config ==========
AUDIO_SAMPLE_RATE=16000
AUDIO_MAX_DURATION_SEC=30

# ========== Security ==========
# API key required in X-API-Key header for all protected endpoints.
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required when DEBUG=false. Must be ≥32 chars and not in the weak-key blocklist.
API_KEY=your-secret-api-key-here

# Per-request timeout. Requests exceeding this return HTTP 504.
REQUEST_TIMEOUT_SEC=90

# ========== Rate Limiting ==========
# Master switch. Set to false in tests / CI to disable rate limiting.
RATE_LIMIT_ENABLED=true
# Per-key per-minute caps. Key = IP by default, OR end-user-id when called
# from a trusted backend with X-Service-Auth (see SERVICE_API_KEY below).
RATE_LIMIT_EVALUATE_PER_MINUTE=20
RATE_LIMIT_TRANSCRIBE_PER_MINUTE=15
RATE_LIMIT_TEXT_ANALYSIS_PER_MINUTE=120

# CIDRs whose X-Forwarded-For header should be trusted for client-IP keying.
# Default = Docker RFC1918 ranges (Coolify Traefik convention).
# Narrow to your specific Coolify proxy IP via:
#   docker network inspect coolify | grep Subnet
TRUSTED_PROXY_CIDRS_STR=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# TRUSTED_PROXY_CIDRS_STR=0.0.0.0/0,::/0

# ========== Internal Microservice Mode (Per-User Rate Limit Redesign) ==========
# Set when this service is called from a trusted backend (Product BE) which
# wants per-end-user rate limiting instead of per-IP. The backend must:
#   1. Be on a trusted-proxy CIDR (TRUSTED_PROXY_CIDRS_STR)
#   2. Send header: X-Service-Auth: <SERVICE_API_KEY>
#   3. Send header: X-End-User-Id: <user-uuid|anon-session-id>
#
# Leave empty (default) to disable per-user keying — all callers key by IP.
# Generate strong key: python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_API_KEY=

# ========== CORS ==========
# Comma-separated list of allowed origins (no spaces around commas).
# Use * to allow all origins (development only).
# Example: CORS_ORIGINS_STR=https://app.example.com,https://admin.example.com
CORS_ORIGINS_STR=*

# ========== Concurrency (Phase 02) ==========
# 0 = auto-detect via cgroup-aware sched_getaffinity, capped at 4.
# Set a positive value to override. Torch threads per slot = cores // slots.
# Measured: 4 vCPU → 2 (best p50/p90 at same throughput); 2 vCPU → 0 (auto = 1).
MAX_CONCURRENT_INFERENCES=0

# Requests waiting > this many seconds in the inference queue → HTTP 503.
# Coolify graceful shutdown should be set to > QUEUE_TIMEOUT + max inference time.
INFERENCE_QUEUE_TIMEOUT_SEC=60

# ========== Logging ==========
# DEBUG=false → JSON one-line-per-record (for log aggregators).
# DEBUG=true  → human-readable colorised text (for local dev).
LOG_LEVEL=INFO
